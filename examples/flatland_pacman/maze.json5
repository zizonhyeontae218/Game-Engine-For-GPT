  ],
  "rules": [
    {
      "id": "welcome",
      "on": "start",
      "once": true,
      "actions": [
        {
          "op": "say",
          "text": "FLATLAND / MAZE CHASE\nCollect every dot. Power dots turn ghosts blue for 7 seconds.\nJoystick or arrow keys / WASD. Use the rotation button for landscape.\nThree lives. Save resumes the maze exactly."
        }
      ]
    },
    {
      "id": "eat_ghost",
      "on": "contact",
      "target_tag": "ghost",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "timer",
            "id": "power"
          },
          {
            "op": "vulnerable",
            "entity": "$target"
          }
        ]
      },
      "actions": [
        {
          "op": "add",
          "key": "game.score",
          "value": 200
        },
        {
          "op": "respawn",
          "entity": "$target",
          "immunity": 120
        },
        {
          "op": "sound",
          "cue": "ghost"
        }
      ]
    },
    {
      "id": "ghost_hit",
      "on": "contact",
      "target_tag": "ghost",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "not",
            "condition": {
              "op": "timer",
              "id": "power"
            }
          },
          {
            "op": "vulnerable",
            "entity": "player"
          }
        ]
      },
      "actions": [
        {
          "op": "damage",
          "entity": "player",
          "amount": 1,
          "immunity": 180
        },
        {
          "op": "respawn",
          "entity": "player"
        }
      ]
    },
    {
      "id": "lose",
      "on": "tick",
      "once": true,
      "when": {
        "op": "hp",
        "entity": "player",
        "le": 0
      },
      "actions": [
        {
          "op": "set",
          "key": "game.result",
          "value": "lost"
        },
        {
          "op": "stop"
        },
        {
          "op": "sound",
          "cue": "lose"
        },
        {
          "op": "say",
          "text": "GAME OVER\nThe ghosts caught you. Press RESTART to try again."
        }
      ]
    },
    {
      "id": "win",
      "on": "tick",
      "once": true,
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "remaining",
            "tag": "food",
            "count": 0
          },
          {
            "op": "not",
            "condition": {
              "op": "hp",
              "entity": "player",
              "le": 0
            }
          }
        ]
      },
      "actions": [
        {
          "op": "set",
          "key": "game.result",
          "value": "won"
        },
        {
          "op": "stop"
        },
        {
          "op": "sound",
          "cue": "win"
        },
        {
          "op": "say",
          "text": "MAZE CLEARED!\nEvery dot collected. Press RESTART for another round."
        }
      ]
    }
  ],
  "script": "hooks.lua",
  "sounds": {
    "eat": "assets/eat.wav",
    "power": "assets/power.wav",
    "ghost": "assets/ghost.wav",
    "lose": "assets/lose.wav",
    "win": "assets/win.wav"
  }
}
