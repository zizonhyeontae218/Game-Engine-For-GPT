  "rules": [
    {
      "id": "walk_event",
      "on": "action.view",
      "actions": [
        {
          "op": "event_scene",
          "event": "view"
        }
      ]
    },
    {
      "id": "battle_progress",
      "on": "battle_win",
      "actions": [
        {
          "op": "objective",
          "quest": "research",
          "objective": "battle"
        }
      ],
      "when": {
        "op": "quest_is",
        "quest": "research",
        "status": "active"
      },
      "once": true
    },
    {
      "id": "camera_progress",
      "on": "tick",
      "actions": [
        {
          "op": "objective",
          "quest": "research",
          "objective": "view"
        }
      ],
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "state",
            "key": "town.viewed",
            "eq": true
          },
          {
            "op": "quest_is",
            "quest": "research",
            "status": "active"
          }
        ]
      },
      "once": true
    },
    {
      "id": "initial",
      "on": "start",
      "actions": [
        {
          "op": "quest",
          "quest": "research",
          "status": "active"
        },
        {
          "op": "give",
          "item": "potion",
          "count": 5
        },
        {
          "op": "give",
          "item": "blade",
          "count": 1
        },
        {
          "op": "equip",
          "slot": "weapon",
          "item": "blade"
        },
        {
          "op": "music",
          "cue": "music",
          "volume": 25
        },
        {
          "op": "event_scene",
          "event": "intro"
        }
      ],
      "once": true
    },
    {
      "id": "rival",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "battle"
        }
      ],
      "target_tag": "rival"
    },
    {
      "id": "journal",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "journal"
        }
      ],
      "target_tag": "journal"
    },
    {
      "id": "view",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "view"
        }
      ],
      "target_tag": "view"
    },
    {
      "id": "tour",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "cutscene"
        }
      ],
      "target_tag": "tour"
    },
    {
      "id": "mail",
      "on": "interact",
      "actions": [
        {
          "op": "say",
          "text": "편지가 도착했습니다. 연구소에 가서 새 동료를 만나 보세요!"
        }
      ],
      "target_tag": "mail"
    },
    {
      "id": "finish_research",
      "on": "tick",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "quest_is",
            "quest": "research",
            "status": "active"
          },
          {
            "op": "objectives_complete",
            "quest": "research"
          }
        ]
      },
      "actions": [
        {
          "op": "quest",
          "quest": "research",
          "status": "completed"
        }
      ]
    }
  ],
  "script": "data/town.lua",
  "sounds": {
    "music": "audio/music.wav",
    "hit": "audio/hit.wav",
    "door": "audio/door.wav",
    "quest": "audio/quest.wav"
  }
