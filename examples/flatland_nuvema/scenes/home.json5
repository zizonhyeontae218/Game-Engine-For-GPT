  "rules": [
    {
      "id": "walk_event",
      "on": "action.view",
      "actions": [
        {
          "op": "event_scene",
          "event": "view"
        }
      ]
    },
    {
      "id": "battle_progress",
      "on": "battle_win",
      "actions": [
        {
          "op": "objective",
          "quest": "research",
          "objective": "battle"
        }
      ],
      "when": {
        "op": "quest_is",
        "quest": "research",
        "status": "active"
      },
      "once": true
    },
    {
      "id": "camera_progress",
      "on": "tick",
      "actions": [
        {
          "op": "objective",
          "quest": "research",
          "objective": "view"
        }
      ],
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "state",
            "key": "town.viewed",
            "eq": true
          },
          {
            "op": "quest_is",
            "quest": "research",
            "status": "active"
          }
        ]
      },
      "once": true
    },
    {
      "id": "home_chat",
      "on": "interact",
      "actions": [
        {
          "op": "say",
          "text": "잘 다녀와! 연구소는 마을 북서쪽에 있어. 걸을 때 손을 떼면 현재 한 칸을 마치고 멈춘단다."
        }
      ],
      "target_tag": "mom"
    },
    {
      "id": "finish_research",
      "on": "tick",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "quest_is",
            "quest": "research",
            "status": "active"
          },
          {
            "op": "objectives_complete",
            "quest": "research"
          }
        ]
      },
      "actions": [
        {
          "op": "quest",
          "quest": "research",
          "status": "completed"
        }
      ]
    }
  ],
  "script": "data/town.lua",
  "sounds": {
