  "rules": [
    {
      "id": "welcome",
      "on": "start",
      "actions": [
        {
          "op": "music",
          "cue": "music",
          "volume": 25
        },
        {
          "op": "event_scene",
          "event": "intro"
        }
      ],
      "once": true
    },
    {
      "id": "sword",
      "on": "action.melee",
      "actions": [
        {
          "op": "attack",
          "entity": "$player",
          "attack": "blade"
        }
      ]
    },
    {
      "id": "bolt",
      "on": "action.shoot",
      "actions": [
        {
          "op": "attack",
          "entity": "$player",
          "attack": "bolt"
        }
      ]
    },
    {
      "id": "heal",
      "on": "action.heal",
      "actions": [
        {
          "op": "use",
          "item": "potion"
        }
      ],
      "when": {
        "op": "has_item",
        "item": "potion",
        "count": 1
      }
    },
    {
      "id": "key_progress",
      "on": "pickup",
      "actions": [
        {
          "op": "objective",
          "quest": "signal",
          "objective": "key"
        }
      ],
      "target_tag": "key",
      "when": {
        "op": "quest_is",
        "quest": "signal",
        "status": "active"
      },
      "once": true
    },
    {
      "id": "guard_progress",
      "on": "death",
      "actions": [
        {
          "op": "objective",
          "quest": "signal",
          "objective": "combat"
        }
      ],
      "target_tag": "enemy",
      "when": {
        "op": "quest_is",
        "quest": "signal",
        "status": "active"
      },
      "once": true
    },
    {
      "id": "guide",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "journal"
        }
      ],
      "target_tag": "guide"
    },
    {
      "id": "open_gate",
      "on": "interact",
      "actions": [
        {
          "op": "take",
          "item": "key",
          "count": 1
        },
        {
          "op": "map_patch",
          "at": [
            16,
            10
          ],
          "tile": "."
        },
        {
          "op": "sound",
          "cue": "door"
        },
        {
          "op": "remove",
          "entity": "gate"
        }
      ],
      "target_tag": "gate",
      "when": {
        "op": "has_item",
        "item": "key",
        "count": 1
      },
      "once": true
    },
    {
      "id": "arena",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "arena"
        }
      ],
      "target_tag": "arena"
    },
    {
      "id": "cinema",
      "on": "interact",
      "actions": [
        {
          "op": "event_scene",
          "event": "cutscene"
        }
      ],
      "target_tag": "cinema"
    },
    {
      "id": "upper",
      "on": "interact",
      "actions": [
        {
          "op": "plane",
          "entity": "$player",
          "plane": 1
        },
        {
          "op": "elevate",
          "entity": "$player",
          "z": 8
        }
      ],
      "target_tag": "ramp_up"
    },
    {
      "id": "lower",
      "on": "interact",
      "actions": [
        {
          "op": "plane",
          "entity": "$player",
          "plane": 0
        },
        {
          "op": "elevate",
          "entity": "$player",
          "z": 0
        }
      ],
      "target_tag": "ramp_down"
    },
    {
      "id": "battle_progress",
      "on": "battle_win",
      "actions": [
        {
          "op": "objective",
          "quest": "signal",
          "objective": "battle"
        }
      ],
      "when": {
        "op": "quest_is",
        "quest": "signal",
        "status": "active"
      },
      "once": true
    },
    {
      "id": "finish",
      "on": "tick",
      "actions": [
        {
          "op": "quest",
          "quest": "signal",
          "status": "completed"
        }
      ],
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "quest_is",
            "quest": "signal",
            "status": "active"
          },
          {
            "op": "objectives_complete",
            "quest": "signal"
          }
        ]
      },
      "once": true
    },
    {
      "id": "dead",
      "on": "tick",
      "actions": [
        {
          "op": "say",
          "text": "피격 실험 완료: HP 0. 메뉴에서 새 게임으로 재시작하세요."
        },
        {
          "op": "stop"
        }
      ],
      "when": {
        "op": "hp",
        "entity": "player",
        "le": 0
      },
      "once": true
    }
  ]
}
